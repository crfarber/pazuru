{
  "name": "murdoku",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "generate": "esbuild scripts/generate-batch.ts --bundle --platform=node --format=cjs --outfile=.tmp/batch.cjs --log-level=warning && node .tmp/batch.cjs",
    "smoke": "esbuild scripts/smoke.ts --bundle --platform=node --format=cjs --outfile=.tmp/smoke.cjs --log-level=warning && node .tmp/smoke.cjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
